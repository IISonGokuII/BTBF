<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- WebView Container -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Nativer Maus-Cursor Overlay -->
        <View
            android:id="@+id/cursorView"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:elevation="100dp" />

    </FrameLayout>

    <!-- Fullscreen Container für Video -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@android:color/transparent"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Quick Access Kategorien Overlay (oben) -->
    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Kategorie Buttons -->
            <Button
                android:id="@+id/btnCatHome"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="Home"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCatNew"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="Neu"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCatTop"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="Top"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCatRandom"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="Zufall"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCatSearch"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="Suche"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Button Container für Navigation (scrollbar) - initial versteckt -->
    <HorizontalScrollView
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/buttonInnerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Home Button -->
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="@android:color/white" />

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zurück"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white" />

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Aktualisieren"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="@android:color/white" />

            <!-- Search Button -->
            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Suche"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@android:color/white" />

            <!-- Download Button -->
            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Download"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@android:drawable/stat_sys_download"
                app:tint="@android:color/white" />

            <!-- Fullscreen Button -->
            <ImageButton
                android:id="@+id/btnFullscreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Vollbild"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@android:color/white" />

            <!-- Favorites Button -->
            <ImageButton
                android:id="@+id/btnFavorites"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favoriten"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="@android:color/white" />

            <!-- Settings/Einstellungen Button -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Einstellungen"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="@android:color/white" />

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
